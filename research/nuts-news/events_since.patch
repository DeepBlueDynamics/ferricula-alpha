+#[derive(Deserialize)]
+struct EventsSinceParams {
+    after: Option<u64>,
+    limit: Option<u32>,
+}
+
+async fn events_since_get(
+    State(app): State<App>,
+    Query(params): Query<EventsSinceParams>,
+) -> impl IntoResponse {
+    let after = params.after.unwrap_or(0);
+    let limit = params.limit.unwrap_or(30);
+    if !(1..=500).contains(&limit) {
+        return (StatusCode::BAD_REQUEST, "limit must be in 1..=500").into_response();
+    }
+    let instance = app.base_url.trim_start_matches("http://")
+        .trim_start_matches("https://")
+        .split(':')
+        .next()
+        .unwrap_or("news.nuts.services")
+        .to_string();
+    let page = app.store.events_since(after, limit as usize, instance);
+    Json(page).into_response()
+}
