+    pub fn events_since(&self, after: u64, limit: usize, instance: String) -> EventPage {
+        let st = self.state.read().unwrap();
+        let ledger_height = st.event_count;
+        let len = st.ledger.len() as u64;
+        let ledger_floor = if ledger_height == 0 {
+            0
+        } else {
+            ledger_height.saturating_sub(len) + 1
+        };
+
+        if after > 0 && after < ledger_floor.saturating_sub(1) {
+            return EventPage {
+                instance,
+                ledger_floor,
+                ledger_height,
+                gap: true,
+                events: Vec::new(),
+            };
+        }
+
+        let mut events = Vec::new();
+        for (seq, ev) in st.ledger.iter() {
+            if *seq > after {
+                events.push(EventEnvelope {
+                    seq: *seq,
+                    event: ev.clone(),
+                });
+                if events.len() >= limit {
+                    break;
+                }
+            }
+        }
+
+        EventPage {
+            instance,
+            ledger_floor,
+            ledger_height,
+            gap: false,
+            events,
+        }
+    }
 }
 
