+    #[tokio::test]
+    async fn test_events_since_gap_and_limit() {
+        let temp = tempfile::NamedTempFile::new().unwrap();
+        let store = Squirrel::open(temp.path()).unwrap();
+        
+        for i in 1..=10 {
+            store.commit(Event::VoteCast {
+                by: format!("user{}", i),
+                target: 100,
+                ts: 123456,
+            }).await.unwrap();
+        }
+
+        let page = store.events_since(0, 5, "test.instance".to_string());
+        assert_eq!(page.events.len(), 5);
+        assert_eq!(page.ledger_height, 10);
+        assert_eq!(page.ledger_floor, 1);
+        assert!(!page.gap);
+
+        let page = store.events_since(5, 5, "test.instance".to_string());
+        assert_eq!(page.events.len(), 5);
+        assert_eq!(page.events[0].seq, 6);
+
+        {
+            let mut st = store.state.write().unwrap();
+            while st.ledger.len() > 3 {
+                st.ledger.pop_front();
+            }
+        }
+
+        let page = store.events_since(5, 5, "test.instance".to_string());
+        assert!(page.gap);
+        assert!(page.events.is_empty());
+    }
 }
